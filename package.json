{
  "name": "pi-codex-app-server",
  "version": "0.1.0",
  "description": "Expose Pi Coding Agent through the Codex App Server and ChatGPT Remote protocols.",
  "keywords": [
    "app-server",
    "chatgpt-remote",
    "codex",
    "pi-coding-agent",
    "pi-package"
  ],
  "bin": {
    "pi-codex-app-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "vendor/openai-codex-app-server-protocol",
    "README.md",
    "CONTEXT.md"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@logtape/logtape": "^2.3.2",
    "@logtape/redaction": "^2.3.2",
    "ajv": "^8.17.1",
    "es-toolkit": "^1.39.10",
    "json-rpc-2.0": "^1.7.1",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/bun": "^1.2.21",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "json-schema-faker": "^0.6.3",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^5.9.2",
    "ultracite": "7.10.6",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  }
}
